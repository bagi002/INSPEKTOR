@startuml Class Diagram
title Class Diagram - Case workspace dokumentacija (vremenska linija, dosijei, izjave, policijski dokumenti, saslusanja)

class App {
  +resolveRoute(pathname): ReactNode
  +isLoggedIn(): boolean
  +handleLogout(): void
  +render()
}

class RouteUtils {
  +normalizePath(pathname)
  +buildCaseWorkspaceRoute(caseId, mode, tab)
  +buildCaseCreatorRoute(caseId)
  +parseCaseWorkspacePath(pathname)
}

class DesktopGate {
  +desktopMinWidth: number
  +isDesktop(): boolean
  +render()
}

class LoggedHomePage {
  +loadHomeData()
  +render()
}

class CreateCasePage {
  +handleCreateCase()
  +render()
}

class CaseWorkspacePage {
  +caseId
  +mode
  +activeTabSlug
  +loadCaseData()
  +renderTabContent()
  +render()
}

class CreateCaseSidebar {
  +mode
  +caseId
  +activeTabSlug
  +onPublish()
  +onLogout()
  +render()
}

class CaseTimelineTab {
  +loadTimeline()
  +handleAddTimelineItem(event)
  +handleAdvanceTimeline()
  +handleSaveTimeline()
  +render()
}

class UseCaseTimelineTabState {
  +state
  +loadTimeline()
  +handleAddTimelineItem(event)
  +handleAdvanceTimeline()
  +handleMoveTimelineItem(localKey, direction)
  +handleSaveTimeline()
}

class CaseTimelineCreateForm {
  +formData
  +onSubmit()
  +render()
}

class CaseTimelineRoadmapItem {
  +item
  +onMove(localKey, direction)
  +onRemove(localKey)
  +render()
}

class CaseTimelineStatCard {
  +value
  +label
  +render()
}

class CaseTimelineHelpers {
  +validateTimelineItemForm(formData, existingItems)
  +buildTimelineSavePayload(items)
  +formatTimelineSourceOption(itemType, source)
}

class CasePeopleTab {
  +loadPeople()
  +openCreateModal()
  +openDossierModal(personId)
  +render()
}

class CasePersonDossierModal {
  +person
  +linkedDocuments
  +onClose()
  +render()
}

class CaseStatementsTab {
  +render()
}

class CasePoliceDocumentsTab {
  +render()
}

class CaseInterrogationsTab {
  +render()
}

class CaseDocumentsTab {
  +category
  +loadDocuments()
  +openCreateModal()
  +openPreviewModal(documentId)
  +render()
}

class UseCaseDocumentsTabState {
  +state
  +loadDocuments()
  +handleCreateDocument()
  +handleRelatedPersonToggle()
  +openCreateModal()
  +openPreviewModal(documentId)
}

class UseCaseInterrogationsTabState {
  +state
  +loadInterrogations()
  +openChatModal(interrogationId)
}

class UseCaseInterrogationCreateState {
  +formData
  +handleAddNode()
  +handleCreateInterrogation(event)
}

class CaseInterrogationCreateStateUtils {
  +buildNodeFromDraft(nodes, nodeDraft)
  +collectInterrogationNodesForRemoval(nodes, rootNodeKey)
  +validateInterrogationFormBeforeSubmit(formData)
}

class UseCaseDocumentFormState {
  +formData
  +formErrors
  +handleFieldChange(event)
  +handleTypeSpecificFieldChange(fieldName, event)
  +handleCreateDocument(event)
}

class UseCaseDocumentImageState {
  +handleDocumentImageUpload(event)
  +handleDocumentImageRemove(imageIndex)
}

class UseCasePeopleLinkedDocumentsState {
  +loadLinkedDocuments()
  +getLinkedDocumentsForPerson(personId)
}

class CaseWorkspaceLinking {
  +buildPersonDossierHref(caseId, mode, personId)
  +buildDocumentPreviewHref(caseId, mode, document)
  +parsePersonIdFromLocationSearch(search)
  +parseDocumentIdFromLocationSearch(search)
}

class CaseDocumentTypeSpecificConfig {
  +getTypeSpecificFieldsForDocumentType(documentType)
  +buildTypeSpecificDefaults(documentType)
  +supportsImageEvidenceForDocumentType(documentType)
}

class CaseDocumentsOverviewPanel {
  +searchValue
  +typeFilter
  +classificationFilter
  +render()
}

class CaseDocumentCreateForm {
  +formData
  +onSubmit()
  +render()
}

class CaseDocumentModal {
  +document
  +onClose()
  +render()
}

class CaseInterrogationCreateModal {
  +formData
  +onSubmit()
  +render()
}

class CaseInterrogationNodeBuilderSection {
  +nodes
  +onAddNode()
  +render()
}

class CaseInterrogationTreePreview {
  +nodes
  +render()
}

class CaseInterrogationChatModal {
  +interrogation
  +handleQuestionPick(node)
  +handleConclude()
  +render()
}

class CaseInterrogationsHelpers {
  +buildNextNodeKey(nodes)
  +buildInterrogationChildrenMap(nodes)
}

class CasePeopleApiClient {
  +fetchCasePeople(caseId, scope)
  +createCasePerson(caseId, payload)
}

class CaseDocumentsApiClient {
  +fetchCaseStatements(caseId, scope)
  +createCaseStatement(caseId, payload)
  +fetchCasePoliceDocuments(caseId, scope)
  +createCasePoliceDocument(caseId, payload)
}

class CaseInterrogationsApiClient {
  +fetchCaseInterrogations(caseId, scope)
  +createCaseInterrogation(caseId, payload)
}

class CaseTimelineApiClient {
  +fetchCaseTimeline(caseId)
  +replaceCaseTimeline(caseId, payload)
  +advanceCaseTimeline(caseId)
}

class CasesApiClient {
  +fetchLoggedHomeCases()
  +createCase(payload)
  +fetchCreatorCase(caseId)
}

class SessionStorageService {
  +saveSession(token, user)
  +getSession()
  +clearSession()
}

class ExpressApp {
  +mountRoutes()
}

class CasesRoutes {
  +GET /home
  +POST /
  +GET /:caseId/creator
  +GET /:caseId/timeline
  +POST /:caseId/timeline/advance
  +PUT /:caseId/timeline
  +GET /:caseId/people
  +POST /:caseId/people
  +GET /:caseId/statements
  +POST /:caseId/statements
  +GET /:caseId/police-documents
  +POST /:caseId/police-documents
  +GET /:caseId/interrogations
  +POST /:caseId/interrogations
}

class CasesController {
  +getLoggedHomeOverviewController(req, res)
  +createCaseController(req, res)
  +getCreatorCaseController(req, res)
  +getCreatorCaseTimelineController(req, res)
  +advanceCaseTimelineController(req, res)
  +replaceCreatorCaseTimelineController(req, res)
  +getCreatorCasePeopleController(req, res)
  +createCreatorCasePersonController(req, res)
  +getCreatorCaseStatementsController(req, res)
  +createCreatorCaseStatementController(req, res)
  +getCreatorCasePoliceDocumentsController(req, res)
  +createCreatorCasePoliceDocumentController(req, res)
  +getCreatorCaseInterrogationsController(req, res)
  +createCreatorCaseInterrogationController(req, res)
}

class CasesService {
  +getLoggedHomeOverview(userId)
  +createCase(payload, userId)
  +getCreatorCase(caseId, userId)
}

class CasePeopleService {
  +getCreatorCasePeople(caseId, userId, scope)
  +createCreatorCasePerson(caseId, payload, userId)
}

class CaseTimelineService {
  +getCreatorCaseTimeline(caseId, userId)
  +advanceCaseTimeline(caseId, userId)
  +replaceCreatorCaseTimeline(caseId, payload, userId)
}

class CaseDocumentsService {
  +getCreatorCaseStatements(caseId, userId, scope)
  +createCreatorCaseStatement(caseId, payload, userId)
  +getCreatorCasePoliceDocuments(caseId, userId, scope)
  +createCreatorCasePoliceDocument(caseId, payload, userId)
}

class CaseInterrogationsService {
  +getCreatorCaseInterrogations(caseId, userId, scope)
  +createCreatorCaseInterrogation(caseId, payload, userId)
}

class CaseSolveVisibilityService {
  +normalizeCaseReadScope(scope)
  +getSolveVisibilityForUser(caseId, userId)
}

class CasePeopleValidation {
  +validateCreateCasePersonPayload(payload)
}

class CaseTimelineValidation {
  +validateReplaceCaseTimelinePayload(payload, availableSources)
}

class CaseDocumentsValidation {
  +validateCreateCaseStatementPayload(payload)
  +validateCreateCasePoliceDocumentPayload(payload)
}

class CaseInterrogationsValidation {
  +validateCreateCaseInterrogationPayload(payload)
}

class CaseDocumentsTypeSpecificValidation {
  +validateTypeSpecificMetadata(documentType, rawTypeSpecific, errors)
}

class CaseDocumentsValidationShared {
  +sanitizeImageEvidence(value)
  +sanitizeDocumentType(value, allowedTypes, fallbackType)
}

class CasesRepository {
  +createCaseWithDetails(payload)
  +getHomeOverviewRows(userId)
  +findCaseById(caseId)
  +findCaseByIdForAuthor(caseId, userId)
}

class CasePeopleRepository {
  +getCasePeopleByCaseId(caseId)
  +createCasePersonForCase(caseId, payload, userId)
}

class CaseTimelineRepository {
  +getCaseTimelineItemsByCaseId(caseId)
  +getCaseTimelinePeopleSourcesByCaseId(caseId)
  +getCaseTimelineDocumentSourcesByCaseId(caseId)
  +replaceCaseTimelineItems(caseId, items)
}

class CaseProgressRepository {
  +ensureCaseUserProgressByCaseIdAndUserId(caseId, userId)
  +upsertCaseUserProgress(caseId, userId, payload)
  +normalizeCaseUserProgressForTimeline(caseId, totalTimelineItems)
}

class CaseDocumentsRepository {
  +getCaseDocumentsByCaseIdAndTypes(caseId, types)
  +createCaseDocumentForCase(caseId, payload)
  +getCasePeopleDirectoryByCaseId(caseId)
}

class CaseInterrogationsRepository {
  +getCaseInterrogationsByCaseId(caseId)
  +upsertCaseInterrogationForPerson(caseId, payload, userId)
}

UseCaseInterrogationCreateState --> CaseInterrogationCreateStateUtils
CaseInterrogationCreateModal --> CaseInterrogationNodeBuilderSection
CaseInterrogationNodeBuilderSection --> CaseInterrogationTreePreview

class AuthGuardMiddleware {
  +requireAuth(req, res, next)
}

class DatabaseModule {
  +initializeDatabase()
  +getDatabase()
  +applyMigrations()
}

class SQLiteDatabase {
  +users
  +cases
  +case_people
  +case_person_dossiers
  +case_person_dossier_profiles
  +case_documents(metadata_json)
  +case_interrogations
  +case_interrogation_nodes
  +case_timeline_items
  +case_user_progress
}

