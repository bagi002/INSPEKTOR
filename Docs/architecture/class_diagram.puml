@startuml Class Diagram
title Class Diagram - Case workspace dokumentacija (dosijei, izjave, policijski dokumenti)

class App {
  +resolveRoute(pathname): ReactNode
  +isLoggedIn(): boolean
  +handleLogout(): void
  +render()
}

class RouteUtils {
  +normalizePath(pathname)
  +buildCaseWorkspaceRoute(caseId, mode, tab)
  +buildCaseCreatorRoute(caseId)
  +parseCaseWorkspacePath(pathname)
}

class DesktopGate {
  +desktopMinWidth: number
  +isDesktop(): boolean
  +render()
}

class LoggedHomePage {
  +loadHomeData()
  +render()
}

class CreateCasePage {
  +handleCreateCase()
  +render()
}

class CaseWorkspacePage {
  +caseId
  +mode
  +activeTabSlug
  +loadCaseData()
  +renderTabContent()
  +render()
}

class CreateCaseSidebar {
  +mode
  +caseId
  +activeTabSlug
  +onPublish()
  +onLogout()
  +render()
}

class CasePeopleTab {
  +loadPeople()
  +openCreateModal()
  +openDossierModal(personId)
  +render()
}

class CasePersonDossierModal {
  +person
  +linkedDocuments
  +onClose()
  +render()
}

class CaseStatementsTab {
  +render()
}

class CasePoliceDocumentsTab {
  +render()
}

class CaseDocumentsTab {
  +category
  +loadDocuments()
  +openCreateModal()
  +openPreviewModal(documentId)
  +render()
}

class UseCaseDocumentsTabState {
  +state
  +loadDocuments()
  +handleCreateDocument()
  +handleRelatedPersonToggle()
  +openCreateModal()
  +openPreviewModal(documentId)
}

class UseCaseDocumentFormState {
  +formData
  +formErrors
  +handleFieldChange(event)
  +handleTypeSpecificFieldChange(fieldName, event)
  +handleCreateDocument(event)
}

class UseCaseDocumentImageState {
  +handleDocumentImageUpload(event)
  +handleDocumentImageRemove(imageIndex)
}

class UseCasePeopleLinkedDocumentsState {
  +loadLinkedDocuments()
  +getLinkedDocumentsForPerson(personId)
}

class CaseWorkspaceLinking {
  +buildPersonDossierHref(caseId, mode, personId)
  +buildDocumentPreviewHref(caseId, mode, document)
  +parsePersonIdFromLocationSearch(search)
  +parseDocumentIdFromLocationSearch(search)
}

class CaseDocumentTypeSpecificConfig {
  +getTypeSpecificFieldsForDocumentType(documentType)
  +buildTypeSpecificDefaults(documentType)
  +supportsImageEvidenceForDocumentType(documentType)
}

class CaseDocumentsOverviewPanel {
  +searchValue
  +typeFilter
  +classificationFilter
  +render()
}

class CaseDocumentCreateForm {
  +formData
  +onSubmit()
  +render()
}

class CaseDocumentModal {
  +document
  +onClose()
  +render()
}

class CasePeopleApiClient {
  +fetchCasePeople(caseId)
  +createCasePerson(caseId, payload)
}

class CaseDocumentsApiClient {
  +fetchCaseStatements(caseId)
  +createCaseStatement(caseId, payload)
  +fetchCasePoliceDocuments(caseId)
  +createCasePoliceDocument(caseId, payload)
}

class CasesApiClient {
  +fetchLoggedHomeCases()
  +createCase(payload)
  +fetchCreatorCase(caseId)
}

class SessionStorageService {
  +saveSession(token, user)
  +getSession()
  +clearSession()
}

class ExpressApp {
  +mountRoutes()
}

class CasesRoutes {
  +GET /home
  +POST /
  +GET /:caseId/creator
  +GET /:caseId/people
  +POST /:caseId/people
  +GET /:caseId/statements
  +POST /:caseId/statements
  +GET /:caseId/police-documents
  +POST /:caseId/police-documents
}

class CasesController {
  +getLoggedHomeOverviewController(req, res)
  +createCaseController(req, res)
  +getCreatorCaseController(req, res)
  +getCreatorCasePeopleController(req, res)
  +createCreatorCasePersonController(req, res)
  +getCreatorCaseStatementsController(req, res)
  +createCreatorCaseStatementController(req, res)
  +getCreatorCasePoliceDocumentsController(req, res)
  +createCreatorCasePoliceDocumentController(req, res)
}

class CasesService {
  +getLoggedHomeOverview(userId)
  +createCase(payload, userId)
  +getCreatorCase(caseId, userId)
}

class CasePeopleService {
  +getCreatorCasePeople(caseId, userId)
  +createCreatorCasePerson(caseId, payload, userId)
}

class CaseDocumentsService {
  +getCreatorCaseStatements(caseId, userId)
  +createCreatorCaseStatement(caseId, payload, userId)
  +getCreatorCasePoliceDocuments(caseId, userId)
  +createCreatorCasePoliceDocument(caseId, payload, userId)
}

class CasePeopleValidation {
  +validateCreateCasePersonPayload(payload)
}

class CaseDocumentsValidation {
  +validateCreateCaseStatementPayload(payload)
  +validateCreateCasePoliceDocumentPayload(payload)
}

class CaseDocumentsTypeSpecificValidation {
  +validateTypeSpecificMetadata(documentType, rawTypeSpecific, errors)
}

class CaseDocumentsValidationShared {
  +sanitizeImageEvidence(value)
  +sanitizeDocumentType(value, allowedTypes, fallbackType)
}

class CasesRepository {
  +createCaseWithDetails(payload)
  +getHomeOverviewRows(userId)
  +findCaseByIdForAuthor(caseId, userId)
}

class CasePeopleRepository {
  +getCasePeopleByCaseId(caseId)
  +createCasePersonForCase(caseId, payload, userId)
}

class CaseDocumentsRepository {
  +getCaseDocumentsByCaseIdAndTypes(caseId, types)
  +createCaseDocumentForCase(caseId, payload)
  +getCasePeopleDirectoryByCaseId(caseId)
}

class AuthGuardMiddleware {
  +requireAuth(req, res, next)
}

class DatabaseModule {
  +initializeDatabase()
  +getDatabase()
  +applyMigrations()
}

class SQLiteDatabase {
  +users
  +cases
  +case_people
  +case_person_dossiers
  +case_person_dossier_profiles
  +case_documents(metadata_json)
  +case_timeline_items
  +case_user_progress
}

App --> RouteUtils
App --> DesktopGate
DesktopGate --> LoggedHomePage
DesktopGate --> CreateCasePage
DesktopGate --> CaseWorkspacePage

CaseWorkspacePage *-- CreateCaseSidebar
CaseWorkspacePage *-- CasePeopleTab
CaseWorkspacePage *-- CaseStatementsTab
CaseWorkspacePage *-- CasePoliceDocumentsTab
CasePeopleTab *-- CasePersonDossierModal
CaseStatementsTab *-- CaseDocumentsTab
CasePoliceDocumentsTab *-- CaseDocumentsTab
CaseDocumentsTab ..> UseCaseDocumentsTabState
UseCaseDocumentsTabState ..> UseCaseDocumentFormState
UseCaseDocumentFormState ..> UseCaseDocumentImageState
UseCaseDocumentsTabState ..> CaseWorkspaceLinking
CasePeopleTab ..> UseCasePeopleLinkedDocumentsState
CasePeopleTab ..> CaseWorkspaceLinking
UseCasePeopleLinkedDocumentsState ..> CaseDocumentsApiClient
UseCaseDocumentFormState ..> CaseDocumentTypeSpecificConfig
CaseDocumentsTab *-- CaseDocumentsOverviewPanel
CaseDocumentsTab *-- CaseDocumentCreateForm
CaseDocumentsTab *-- CaseDocumentModal
CaseDocumentCreateForm ..> CaseDocumentTypeSpecificConfig
CaseDocumentModal ..> CaseDocumentTypeSpecificConfig
CaseDocumentModal ..> CaseWorkspaceLinking
CasePersonDossierModal ..> CaseWorkspaceLinking

CasePeopleTab ..> CasePeopleApiClient
CaseStatementsTab ..> CaseDocumentsApiClient
CasePoliceDocumentsTab ..> CaseDocumentsApiClient
CaseWorkspacePage ..> CasesApiClient
LoggedHomePage ..> CasesApiClient
CreateCasePage ..> CasesApiClient
CasePeopleApiClient ..> SessionStorageService
CaseDocumentsApiClient ..> SessionStorageService
CasesApiClient ..> SessionStorageService
CasesApiClient ..> RouteUtils

CasePeopleApiClient ..> ExpressApp
CaseDocumentsApiClient ..> ExpressApp
CasesApiClient ..> ExpressApp
ExpressApp --> CasesRoutes
CasesRoutes --> AuthGuardMiddleware
CasesRoutes --> CasesController
CasesController --> CasesService
CasesController --> CasePeopleService
CasesController --> CaseDocumentsService
CasesService --> CasesRepository
CasePeopleService --> CasePeopleValidation
CasePeopleService --> CasesRepository
CasePeopleService --> CasePeopleRepository
CaseDocumentsService --> CaseDocumentsValidation
CaseDocumentsValidation --> CaseDocumentsTypeSpecificValidation
CaseDocumentsValidation --> CaseDocumentsValidationShared
CaseDocumentsService --> CasesRepository
CaseDocumentsService --> CaseDocumentsRepository
CaseDocumentsRepository ..> CaseDocumentsValidationShared
CasesRepository --> DatabaseModule
CasePeopleRepository --> DatabaseModule
CaseDocumentsRepository --> DatabaseModule
DatabaseModule --> SQLiteDatabase
@enduml
