@startuml Block Diagram
title Block Diagram - Osobe i dosijei u slucaju

package "Frontend" {
  [App Shell]
  [Desktop Policy Gate]
  [Route Resolver]
  [Protected Route Guard]
  [Route Utils]
  [Public Auth Pages]
  [Logged Home Page]
  [Logged Case Section]
  [Logged Home Data Helpers]
  [Logged Sidebar]
  [Create Case Start Page]
  [Case Workspace Page]
  [Shared Case Sidebar]
  [Case Workspace Tabs]
  [Case People Tab]
  [People List View]
  [Create Person Modal]
  [Dropdown Field Sets]
  [Photo Upload Handler]
  [Dossier Modal View]
  [Dossier Document Layout]
  [Case People State Hook]
  [Publish Action Button]
  [Auth API Client]
  [Cases API Client]
  [Case People API Client]
  [Session Storage]
  [Logout Action]
  [Desktop Warning View]
}

package "Backend (Node.js + Express)" {
  [Express App]
  [Auth Routes]
  [Cases Routes]
  [Auth Guard Middleware]
  [Auth Service]
  [Cases Service]
  [Case People Service]
  [Cases Validation]
  [Case People Validation]
  [JWT Token Service]
  [User Repository]
  [Cases Repository]
  [Case People Repository]
  [SQLite Module]
  [Migration Runner]
  [Health Route]
}

database "SQLite Database" as Db
database "cases + documents + timeline" as CasesDb
database "case_people + case_person_dossiers + case_person_dossier_profiles" as PeopleDb

[App Shell] --> [Desktop Policy Gate]
