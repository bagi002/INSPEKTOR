    AdminAccountsStore --> AdminRepo: null
    AdminRepo --> AdminService: null
    AdminService -> UserRepo: findUserByEmail(email)
    UserRepo -> UsersStore: SELECT user(role + password_hash) po email
    UsersStore --> UserRepo: users row
    UserRepo --> AdminService: users row
    AdminService -> AdminRepo: upsertAdminAccountFromUserProfile(...)
    AdminRepo -> AdminAccountsStore: UPSERT admin_accounts(is_active=1)
    AdminAccountsStore --> AdminRepo: potvrda upsert-a
    AdminRepo --> AdminService: admin nalog aktiviran
    AdminService -> AdminRepo: findAdminAccountByEmail(email)
    AdminRepo -> AdminAccountsStore: SELECT admin_account po email
    AdminAccountsStore --> AdminRepo: admin account row
    AdminRepo --> AdminService: admin account
  end
  AdminService --> AdminApi: admin JWT token + admin account
  AdminApi --> AdminClient: JSON uspeh
  AdminClient -> AdminSessionStore: Upis admin tokena
  AdminLoginView -> AdminDashboard: Render tabovanog dashboard prikaza

  AdminDashboard -> AdminClient: GET /api/admin/overview
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminService: getAdminOverview()
  AdminService -> AdminRepo: getAdminOverviewCounts()
  AdminRepo -> UsersStore: SELECT broj korisnika/admina
  AdminRepo -> CasesStore: SELECT broj slucajeva
  AdminRepo -> SupportStore: SELECT broj tiketa po statusima
  AdminRepo --> AdminService: overview metrika
  AdminService --> AdminApi: response payload
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Brzi pregled metrika

  AdminDashboard -> AdminClient: GET /api/admin/settings
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminSettingsService: getAdminSettings()
  AdminSettingsService -> AppSettingsRepo: getActiveAppVersionSetting()
  AppSettingsRepo -> AppSettingsStore: SELECT active_app_version
  AppSettingsStore --> AppSettingsRepo: aktivna verzija
  AppSettingsRepo --> AdminSettingsService: aktivna verzija
  AdminSettingsService --> AdminApi: response payload
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Prikaz aktivne verzije u tabu "Podesavanja"

  AdminDashboard -> AdminClient: GET /api/admin/tickets
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminService: getAdminTickets()
  AdminService -> SupportRepo: getAllSupportTickets()
  SupportRepo -> SupportStore: SELECT svi ticketi
  SupportRepo -> UsersStore: JOIN nalog prijave po ticketu
  SupportRepo --> AdminService: ticketi + reporter podaci
  AdminService --> AdminApi: response payload
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Lista tiketa sa tipom, statusom i reporter metapodacima
  AdminDashboard -> AdminDashboard: Prikaz matrice tiketa po tipu/statusu + filteri/pretraga + kolor akcenti kartica po tipu i statusu

  AdminDashboard -> AdminClient: GET /api/admin/announcements
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminAnnouncementsService: listAdminAnnouncements()
  AdminAnnouncementsService -> AdminAnnouncementsRepo: getAdminAnnouncements()
  AdminAnnouncementsRepo -> AdminAnnouncementsStore: SELECT sva admin obavjestenja
  AdminAnnouncementsRepo -> AdminAccountsStore: JOIN admin naloga kreatora obavjestenja
  AdminAnnouncementsStore --> AdminAnnouncementsRepo: lista obavjestenja
  AdminAccountsStore --> AdminAnnouncementsRepo: podaci admin kreatora
  AdminAnnouncementsRepo --> AdminAnnouncementsService: mapirana lista
  AdminAnnouncementsService --> AdminApi: response payload
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Lista admin obavjestenja

  Admin -> AdminDashboard: Kreira novo popup obavjestenje
  AdminDashboard -> AdminClient: POST /api/admin/announcements
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminAnnouncementsService: createAdminAnnouncementMessage(payload, adminAccountId)
  AdminAnnouncementsService -> AdminAnnouncementsRepo: createAdminAnnouncement(payload)
  AdminAnnouncementsRepo -> AdminAnnouncementsStore: INSERT novo obavjestenje
  AdminAnnouncementsStore --> AdminAnnouncementsRepo: announcementId
  AdminAnnouncementsRepo --> AdminAnnouncementsService: kreirano obavjestenje
  AdminAnnouncementsService --> AdminApi: 201 response
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Osvjezena lista obavjestenja

  Admin -> AdminDashboard: Menja status tiketa (automatsko cuvanje bez dugmeta)
  AdminDashboard -> AdminClient: PATCH /api/admin/tickets/{ticketId}/status
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminService: patchAdminTicketStatus(ticketId, payload)
  AdminService -> SupportRepo: updateSupportTicketStatus(ticketId, status, adminNote)
  SupportRepo -> SupportStore: UPDATE status/admin_note
  SupportStore --> SupportRepo: potvrda izmene
  SupportRepo --> AdminService: azuriran tiket
  AdminService --> AdminApi: 200 response
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Osvjezen status tiketa i board prikaz

  Admin -> AdminDashboard: Menja aktivnu verziju aplikacije
  AdminDashboard -> AdminClient: PATCH /api/admin/settings/active-app-version
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminSettingsService: patchAdminActiveAppVersion(payload)
  AdminSettingsService -> AppSettingsRepo: setActiveAppVersionSetting(version)
  AppSettingsRepo -> AppSettingsStore: UPSERT active_app_version + updated_at
  AppSettingsStore --> AppSettingsRepo: potvrda izmene
  AppSettingsRepo --> AdminSettingsService: nova aktivna verzija
  AdminSettingsService --> AdminApi: 200 response
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Osvjezen prikaz aktivne verzije

  Admin -> AdminDashboard: Menja sopstvenu admin lozinku
  AdminDashboard -> AdminClient: PATCH /api/admin/settings/password
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminSettingsService: patchAdminOwnPassword(adminAccountId, payload)
  AdminSettingsService -> AdminRepo: findAdminAccountById(adminAccountId)
  AdminRepo -> AdminAccountsStore: SELECT admin_account + password_hash
  AdminAccountsStore --> AdminRepo: admin account row
  AdminRepo --> AdminSettingsService: admin account
  AdminSettingsService -> AdminRepo: updateAdminAccountPasswordById(adminAccountId, newHash)
  AdminRepo -> AdminAccountsStore: UPDATE admin_accounts(password_hash)
  AdminAccountsStore --> AdminRepo: potvrda izmene
  AdminSettingsService --> AdminApi: 200 response
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Potvrda uspešne promjene lozinke

  AdminDashboard -> AdminClient: GET /api/admin/users + /api/admin/cases
  AdminClient -> AdminApi: HTTP zahtevi
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminService: listAdminUsers() + listAdminCases()
  AdminService -> AdminRepo: getAdminUsers() + getAdminCases()
  AdminRepo -> UsersStore: SELECT korisnici (bez password_hash)
  AdminRepo -> CasesStore: SELECT slucajevi + autori
  AdminRepo --> AdminService: liste za edit
  AdminService --> AdminApi: response payload
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Tabele korisnika i slucajeva

  Admin -> AdminDashboard: Klik "Obrisi" na korisniku
  AdminDashboard -> AdminClient: DELETE /api/admin/users/{userId}
  AdminClient -> AdminApi: HTTP zahtev
  AdminApi -> AdminGuard: Verifikacija admin tokena
  AdminGuard -> AdminService: deleteAdminUser(userId, adminAccountId)
  AdminService -> AdminRepo: findAdminUserById(userId) + findAdminAccountById(adminAccountId) + countAdminUsers()
  AdminRepo -> UsersStore: SELECT korisnik + broj admin naloga
  AdminRepo -> AdminAccountsStore: SELECT trenutni admin_account
  AdminService -> AdminRepo: deleteAdminUserById(userId)
  AdminRepo -> UsersStore: DELETE users (cascade povezani podaci)
  UsersStore --> AdminRepo: potvrda brisanja
  AdminRepo --> AdminService: delete uspeh
  AdminService --> AdminApi: 200 response
  AdminApi --> AdminClient: JSON uspeh
  AdminClient --> AdminDashboard: Osvjezena lista korisnika
else Manja sirina od desktop praga
  Gate -> Notice: Render poruke "Aplikacija je samo za desktop"
  Notice --> User: Prikaz ogranicenog ekrana
end

@enduml
